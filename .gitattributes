# Keep source portable while preserving benchmark and fixture byte hashes.
* text=auto
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
fixtures/** -text
reports/** -text
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.pdf binary
*.png binary
*.jpg binary
*.docx binary
*.xlsx binary
*.pptx binary
